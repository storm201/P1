# Safe root environment template
# Copy to .env and configure local secret values

# Operator token for private management and audit API endpoints
OPS_TOKEN=replace-with-secure-random-operator-token

# Semantic encoder type: 'sentence_transformers' or 'deterministic_test'
SEMANTIC_ENCODER_TYPE=sentence_transformers

# Periodic verification scheduler settings
SCHEDULER_INTERVAL_HOURS=24
SCHEDULER_REQUEST_BUDGET=150
